# Copia a .env y completá. Nunca subas .env al repo.

# Auth
VIGIEPP_AUTH=1
VIGIEPP_ADMIN_PIN=cambiá-este-pin-admin
VIGIEPP_OPERATOR_PIN=cambiá-este-pin-porteria
VIGIEPP_COOKIE_SECURE=0
# VIGIEPP_API_KEY=
# VIGIEPP_DOCS=1

# Datos
# VIGIEPP_DATA_DIR=/data
# VIGIEPP_EPHEMERAL=0

# Backup durable (Render Free → Hugging Face)
# VIGIEPP_HF_TOKEN=hf_...
# VIGIEPP_HF_REPO=tuusuario/vigiepp-data
# VIGIEPP_HF_FILE=identity-backup.zip

# Inferencia (Render Free)
# VIGIEPP_IMGSZ_MAX=256
# VIGIEPP_SCAN_DEBOUNCE=12
# ULTRALYTICS_OFFLINE=false

# Correo (opcional)
# RESEND_API_KEY=
# VIGIEPP_SMTP_HOST=
# VIGIEPP_SMTP_FROM=
