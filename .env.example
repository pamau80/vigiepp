# VigiEPP — variables de entorno (copiar a .env y ajustar)

# Autenticación
VIGIEPP_AUTH=1
VIGIEPP_ADMIN_PIN=cambiar-admin
VIGIEPP_OPERATOR_PIN=cambiar-operador
VIGIEPP_API_KEY=
VIGIEPP_ALLOW_DEFAULT_PINS=0
VIGIEPP_COOKIE_SECURE=1
VIGIEPP_DOCS=0

# Producción / cloud (Render)
# VIGIEPP_SECRETS_KEY=  # Fernet key para NVR y EHS en disco
# VIGIEPP_METRICS_PUBLIC=0
# VIGIEPP_TRUST_PROXY=1

# CORS — orígenes explícitos (no usar *)
# VIGIEPP_CORS_ORIGINS=https://app.example.com,https://faena.example.com

# RTSP / LAN / anti-SSRF
# VIGIEPP_ALLOW_LAN=1
# VIGIEPP_RTSP_ALLOW=192.168.1.100,camara.local

# Datos locales
# VIGIEPP_DATA_DIR=backend/data

# OIDC / SSO
# VIGIEPP_OIDC_ISSUER=https://login.microsoftonline.com/tenant/v2.0
# VIGIEPP_OIDC_CLIENT_ID=
# VIGIEPP_OIDC_CLIENT_SECRET=
# VIGIEPP_OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# VIGIEPP_OIDC_ADMIN_GROUPS=admins
# VIGIEPP_OIDC_OPERATOR_GROUPS=operators

# Inferencia
VIGIEPP_COMBINED_INFERENCE=0

# Hardening
# VIGIEPP_HSTS=1
# VIGIEPP_MAX_BODY_MB=12
